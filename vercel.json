{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "regions": ["sin1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "excludeFiles": "{tests/**,public/**,backups/**,*.db,*.md}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
